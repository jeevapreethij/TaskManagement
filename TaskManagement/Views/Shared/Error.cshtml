@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="text-danger">Something went wrong</h1>
<p>An unexpected error occurred while processing your request. Please try again later.</p>

@if (Model.ShowRequestId)
{
    <p>
        If the problem continues, quote this reference: <code>@Model.RequestId</code>
    </p>
}
<a class="btn btn-primary" asp-controller="Tasks" asp-action="Index">Back to tasks</a>
