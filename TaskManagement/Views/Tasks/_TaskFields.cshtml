@model TaskManagement.DTOs.TaskFieldsBase
@using TaskManagement.Models

@* Shared field set for the Create and Edit forms. *@
<div class="mb-3">
    <label asp-for="Title" class="form-label"></label>
    <input asp-for="Title" class="form-control" maxlength="200" />
    <span asp-validation-for="Title" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="4" maxlength="2000"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
<div class="row">
    <div class="col-md-4 mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
        <span asp-validation-for="DueDate" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="Priority" class="form-label"></label>
        <select asp-for="Priority" class="form-select" asp-items="@(new SelectList(TaskConstants.Priorities))">
            <option value="">Select priority</option>
        </select>
        <span asp-validation-for="Priority" class="text-danger"></span>
    </div>
    <div class="col-md-4 mb-3">
        <label asp-for="AssignedUserId" class="form-label">Assigned user</label>
        <select asp-for="AssignedUserId" class="form-select" asp-items="@((SelectList)ViewBag.Users)">
            <option value="">Select user</option>
        </select>
        <span asp-validation-for="AssignedUserId" class="text-danger"></span>
    </div>
</div>
