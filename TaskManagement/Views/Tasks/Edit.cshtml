@model TaskManagement.DTOs.UpdateTaskRequest
@{
    ViewData["Title"] = "Edit task";
}

<h1 class="h3 mb-3">Edit task</h1>

<div class="col-md-8">
    <partial name="_EditForm" model="Model" />
    <button type="submit" form="editTaskForm" class="btn btn-primary">Save</button>
    <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.TaskReference">Cancel</a>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
