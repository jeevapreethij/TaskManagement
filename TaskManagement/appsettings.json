{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=TaskMgnt;Integrated Security=True;TrustServerCertificate=True;"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "FilePath": "logs/taskmanagement-.log",
    "RetainedFileCount": 30,
    "FileSizeLimitBytes": 52428800,
    "DatabaseMinimumLevel": "Warning"
  },
  "AllowedHosts": "*"
}
